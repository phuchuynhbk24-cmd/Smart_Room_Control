        <mxCell id="out_relay" value="Khối Chấp hành Relay&#xa;(Opto PC817 + Transistor lái)&#xa;[GPIO Output Active Low]&#xa;Đóng/ngắt tải điện 220VAC (Đèn, Quạt)" style="text;strokeColor=#A5D6A7;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="group_output">
          <mxGeometry y="130" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="out_alarm" value="Chỉ báo &amp; Cảnh báo trạng thái&#xa;(Đồ họa nhấp nháy trên TFT&#xa;&amp; Tín hiệu cảnh báo mở rộng)" style="text;strokeColor=#A5D6A7;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="group_output">
