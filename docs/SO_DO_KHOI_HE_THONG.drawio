          <mxGeometry y="250" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- KHỐI VI XỬ LÝ TRUNG TÂM (VXL) -->
        <mxCell id="box_mcu" value="KHỐI VI XỬ LÝ TRUNG TÂM (MCU)&#xa;&#xa;STM32F103C8T6&#xa;(ARM Cortex-M3 @ 72 MHz)&#xa;&#xa;• Xử lý đồ họa &amp; Quản lý hiển thị HMI&#xa;• Giải mã &amp; Lọc nhiễu cảm ứng Touch&#xa;• Lọc chống rung phím bấm vật lý&#xa;• Xử lý logic tự động &amp; Cảnh báo&#xa;• Quản lý đóng/ngắt các kênh Relay&#xa;• Thu nhận thông số từ Khối Cảm biến" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;strokeWidth=2.5;fontStyle=1;fontSize=12;fontColor=#E65100;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="280" height="360" as="geometry" />
        </mxCell>

        <!-- KHỐI OUTPUTS (BAO NGOÀI) -->
        <mxCell id="group_output" value="KHỐI ĐẦU RA (OUTPUTS)" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;rounded=1;arcSize=10;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=14;fontColor=#1B5E20;" vertex="1" parent="1">
