  <diagram id="block_diagram_smart_room" name="Sơ Đồ Khối Hệ Thống">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- KHỐI INPUTS (BAO NGOÀI) -->
        <mxCell id="group_input" value="KHỐI ĐẦU VÀO (INPUTS)" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;rounded=1;arcSize=10;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;fontSize=14;fontColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="260" height="340" as="geometry" />
        </mxCell>
        <mxCell id="in_touch" value="Màn hình Cảm ứng&#xa;(Touch Screen XPT2046)&#xa;[SPI2: SCK, MOSI, MISO, CS]" style="text;strokeColor=#81D4FA;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="group_input">
