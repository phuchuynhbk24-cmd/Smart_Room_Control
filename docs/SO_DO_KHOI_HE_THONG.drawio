        </mxCell>
        <mxCell id="in_sensor" value="Khối Cảm biến Môi trường&#xa;[Nhiệt độ, Độ ẩm, Ánh sáng, PIR]&#xa;(Đang cập nhật chi tiết...)" style="text;strokeColor=#81D4FA;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=1;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="group_input">
          <mxGeometry y="165" width="260" height="85" as="geometry" />
        </mxCell>
