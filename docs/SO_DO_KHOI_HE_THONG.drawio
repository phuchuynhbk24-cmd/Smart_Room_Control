        <mxCell id="out_lcd" value="Màn hình màu TFT LCD 2.8&quot;&#xa;(ILI9341 - 240x320 RGB565)&#xa;[SPI1 18 MHz: SCK, MOSI, CS, DC, RST]&#xa;Hiển thị Dashboard &amp; Giao diện HMI" style="text;strokeColor=#A5D6A7;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=1;fontSize=11;fontStyle=1;" vertex="1" parent="group_output">
